{
  "manifest_version": 3,
  "name": "FormPilot",
  "version": "2.2.0",
  "description": "Keep profiles and files on your device and fill forms from the side panel.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open FormPilot",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Open FormPilot"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "browser-api.js",
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
